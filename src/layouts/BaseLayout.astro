---
import CtaCluster from "../components/CtaCluster.astro";
import ScrollBlur from "../components/ScrollBlur.astro";
import "../theme.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Varshini Jeyachandran", description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-sans">
    <CtaCluster />
    <slot />
    <ScrollBlur />
  </body>
</html>
