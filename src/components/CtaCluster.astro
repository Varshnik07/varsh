---
// Right-side floating CTAs — no music player, per request.
const ctas = [
  { href: "#writing", label: "More" },
  { href: "https://cal.com/", label: "Calendar" },
];
---

<div class="fixed right-4 top-1/2 z-40 flex -translate-y-1/2 flex-col gap-2">
  {
    ctas.map((cta) => (
      <a
        href={cta.href}
        class="rounded-full border border-white/10 bg-black/40 px-3 py-2 text-xs text-white/70 backdrop-blur-md transition-colors hover:bg-white/10 hover:text-white"
      >
        {cta.label}
      </a>
    ))
  }
</div>
